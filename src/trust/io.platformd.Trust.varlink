# platformd-trustd platform-authentication state interface.
#
# Served on a system Varlink socket at $RUNTIME_DIRECTORY/io.platformd.Trust
# (/run/platformd-trustd/io.platformd.Trust).
interface io.platformd.Trust

# Local boot identity, operating system release, and observed platform state.
method GetBootEvidence() -> (
        bootId: string,
        machineId: string,
        osId: string,
        osName: string,
        osVersion: string,
        firmware: string,
        secureBoot: string,
        tpmPresent: bool,
        measuredBootAvailable: bool,
        evidenceQuality: string
)

type Pcr (
        index: int,
        sha256: string
)

# The TPM SHA-256 PCR bank and event log availability.
method GetMeasuredBoot() -> (
        available: bool,
        pcrBank: string,
        pcrs: []Pcr,
        eventLogPresent: bool,
        bootQuality: string,
        evidenceQuality: string
)

type Session (
        id: string,
        uid: int,
        user: string,
        seat: string,
        type: string,
        class: string,
        state: string,
        active: bool,
        remote: bool,
        locked: bool,
        lockState: string,
        secondsSinceVerification: int,
        verificationRealtimeUSec: int,
        verificationSource: string,
        verificationQuality: string,
        tty: string,
        leader: int,
        userVerified: bool,
        userSource: string,
        evidenceQuality: string
)

# Every logind session, as a trust record. lockState comes from logind.
# Verification fields come from qualifying authentication event submissions.
method ListSessions() -> (sessions: []Session)

# One session's trust record.
method GetSessionTrust(sessionId: string) -> (session: Session)

# Public identity data for a user ID. A signed systemd-homed record is reported
# as verified after its Ed25519 signature is checked.
method GetUserIdentity(uid: int) -> (
        userName: string,
        uid: int,
        source: string,
        verified: bool,
        signingKey: string,
        identityQuality: string
)

type PolicyResult (
        policyId: string,
        sessionId: string,
        result: string,
        reasonCode: string,
        reason: string,
        windowSec: int
)

# Evaluate a named local policy. reasonCode is stable and machine-readable.
# result is "policy-satisfied" or "denied".
method EvaluatePolicy(policy: string, sessionId: string) -> (result: PolicyResult)

type AuthEvent (
        user: string,
        uid: int,
        pamService: string,
        tty: string,
        remoteHost: string,
        phase: string,
        declaredMethod: string,
        result: string,
        sessionId: string,
        qualifiesForFreshness: bool,
        realtimeUSec: int,
        evidenceQuality: string
)

# Submit an authentication event. The caller must be root, and the named session
# must exist and belong to uid. Events are retained as declared audit evidence.
# Only a successful platformd-verifyd event from the platformd-verify PAM service
# qualifies as session freshness.
method SubmitAuthEvent(
        user: string,
        uid: int,
        pamService: string,
        tty: string,
        remoteHost: string,
        phase: string,
        declaredMethod: string,
        result: string,
        sessionId: string
) -> ()

type VerificationContext (
        challengeHex: string,
        audience: string,
        operationDigestHex: string
)

# Declare successful platformd-verify PAM execution for an application context.
# The caller must be root. The session must be local, active, unlocked, and owned
# by the supplied user and UID. Hexadecimal fields contain 32 bytes in lowercase.
# audience is printable ASCII, at most 256 bytes. Completion timestamps use
# CLOCK_BOOTTIME and CLOCK_REALTIME and must be less than 120 seconds old.
# A reply acknowledges receipt, not completion of the asynchronous NV extension.
# Evidence remains root-declared; the context does not prove user consent.
method SubmitVerificationEvent(
        user: string,
        uid: int,
        sessionId: string,
        context: VerificationContext,
        verificationBoottimeUSec: int,
        verificationRealtimeUSec: int
) -> ()

# Recent authentication events, newest first. The list is bounded and in-memory.
method ListAuthEvents() -> (events: []AuthEvent)

type RuntimeEvent (
        # Exact serialized runtime record, including timestamps and provenance.
        description: string,
        digest: string,
        realtimeUSec: int
)

# Authentication and lock state events are extended into a TPM NV index.
# baseline precedes the retained window of at most 1024 events. current is the
# live value. Version 2 replay extends SHA256(description), not description.
# complete requires a matching replay and no measurement failure
# during this service instance. Earlier history is not recovered on restart.
method GetRuntimeLog() -> (
        format: string,
        nvIndex: string,
        baseline: string,
        current: string,
        events: []RuntimeEvent,
        complete: bool,
        evidenceQuality: string
)

# Produce a TPM2 quote over SHA-256 PCRs 0 through 15, bound to nonceHex.
# Runtime events are certified separately from their NV index. All fields are
# hexadecimal. Restricted to user ID 0.
method Attest(nonceHex: string) -> (
        akPublicHex: string,
        quotedHex: string,
        signatureHex: string,
        eventLogHex: string,
        pcrBank: string,
        evidenceQuality: string
)

# Produce a platformd-specific attestation envelope with embedded TPM evidence.
# The legacy field name eat is retained; the format is not RFC 9711 EAT.
# The v2 profile binds serialized runtime timestamps through the NV log.
# The outer JSON and local assertions are unsigned. Restricted to user ID 0.
method GetAttestationToken(nonceHex: string) -> (
        eat: string,
        format: string,
        evidenceQuality: string
)

# Return the Endorsement Key public data and optional manufacturer certificate,
# together with the Attestation Key public data and TPM name.
# Restricted to user ID 0.
method GetEnrollment() -> (
        ekPublicHex: string,
        ekCertHex: string,
        akPublicHex: string,
        akNameHex: string,
        evidenceQuality: string
)

# Activate a credential containing a marshaled TPM2B_ID_OBJECT and
# TPM2B_ENCRYPTED_SECRET. Restricted to user ID 0.
method ActivateCredential(credentialHex: string, secretHex: string) -> (
        challengeHex: string,
        evidenceQuality: string
)

error NoSuchSession()
error UnknownPolicy()
error PermissionDenied()
error InvalidAuthEvent()
error AttestationUnsupported()
error AttestationFailed()
