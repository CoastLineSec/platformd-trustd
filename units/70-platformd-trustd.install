#!/bin/sh
# SPDX-License-Identifier: LGPL-2.1-or-later
# Arguments: COMMAND KERNEL-VERSION ENTRY-DIR KERNEL-IMAGE [INITRD...]

set -eu

case "$1" in
    remove)
        exec trustctl remove-boot-reference "$2"
        ;;
    add)
        [ "${KERNEL_INSTALL_LAYOUT:-}" = uki ] || exit 0
        ;;
    *) exit 0 ;;
esac

uki="${KERNEL_INSTALL_STAGING_AREA:-}/uki.efi"
if [ ! -f "$uki" ]; then
    uki="${4:-}"
fi
if [ -z "$uki" ] || [ ! -f "$uki" ]; then
    echo "platformd-trustd: no UKI is available for boot reference provisioning" >&2
    trustctl remove-boot-reference "$2"
    exit 1
fi

if ! trustctl provision "$uki" "$2"; then
    trustctl remove-boot-reference "$2"
    exit 1
fi
